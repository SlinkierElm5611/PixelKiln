#version 450

// Particles pulled toward a moving attractor with a swirl around it, drag, and soft walls at the view edges.
layout(local_size_x = 256) in;

struct Particle {
    vec2 position; // x in [-aspect, aspect], y in [-1, 1]
    vec2 velocity;
};

layout(set = 0, binding = 0) buffer Particles {
    Particle particles[];
};
layout(set = 0, binding = 1) uniform Params {
    vec2 attractor;
    float deltaTime;
    float time;
    float strength;
    float aspect;
    uint count;
} params;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.count) {
        return;
    }
    Particle p = particles[i];
    vec2 toAttractor = params.attractor - p.position;
    float distance2 = dot(toAttractor, toAttractor) + 0.02;
    vec2 pull = toAttractor * params.strength / distance2;
    vec2 swirl = vec2(-toAttractor.y, toAttractor.x) * (0.35 * params.strength) / distance2;
    // A little per particle variety so the swarm doesn't collapse into one orbit.
    float variety = 0.75 + 0.5 * fract(sin(float(i) * 12.9898) * 43758.5453);
    p.velocity += (pull + swirl) * variety * params.deltaTime;
    p.velocity *= exp(-0.8 * params.deltaTime);
    p.position += p.velocity * params.deltaTime;
    if (abs(p.position.x) > params.aspect) {
        p.position.x = sign(p.position.x) * params.aspect;
        p.velocity.x *= -0.5;
    }
    if (abs(p.position.y) > 1.0) {
        p.position.y = sign(p.position.y);
        p.velocity.y *= -0.5;
    }
    particles[i] = p;
}
