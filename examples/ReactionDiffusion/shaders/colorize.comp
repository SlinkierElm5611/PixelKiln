#version 450

// Turns the chemical concentrations into colors, with a little lighting from the concentration gradient.
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) readonly buffer Cells {
    vec2 cells[];
} grid;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D target;
layout(set = 0, binding = 2) uniform Params {
    uint width;
    uint height;
} params;

float v(int x, int y)
{
    int width = int(params.width);
    int height = int(params.height);
    x = (x + width) % width;
    y = (y + height) % height;
    return grid.cells[y * width + x].y;
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(params.width) || p.y >= int(params.height)) {
        return;
    }
    float value = v(p.x, p.y);
    vec3 color = mix(vec3(0.02, 0.02, 0.06), vec3(0.05, 0.35, 0.55), smoothstep(0.05, 0.2, value));
    color = mix(color, vec3(0.98, 0.85, 0.55), smoothstep(0.2, 0.38, value));
    float slope = (v(p.x + 1, p.y) - v(p.x - 1, p.y)) - (v(p.x, p.y + 1) - v(p.x, p.y - 1));
    color *= clamp(1.0 + slope * 3.0, 0.6, 1.4);
    imageStore(target, p, vec4(color, 1.0));
}
