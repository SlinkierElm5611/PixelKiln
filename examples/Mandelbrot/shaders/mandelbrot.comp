#version 450

// The Mandelbrot set with smooth (continuous escape time) coloring, one invocation per pixel.
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D target;
layout(set = 0, binding = 1) uniform Params {
    vec2 center;
    float scale;          // units of the complex plane per pixel
    float time;
    uint width;
    uint height;
    uint maxIterations;
} params;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(params.width) || p.y >= int(params.height)) {
        return;
    }
    vec2 offset = vec2(p) + 0.5 - 0.5 * vec2(params.width, params.height);
    vec2 c = params.center + vec2(offset.x, -offset.y) * params.scale;
    vec2 z = vec2(0.0);
    uint i = 0u;
    for (; i < params.maxIterations; i++) {
        z = vec2(z.x * z.x - z.y * z.y, 2.0 * z.x * z.y) + c;
        if (dot(z, z) > 256.0) {
            break;
        }
    }
    vec3 color = vec3(0.0);
    if (i < params.maxIterations) {
        float smoothIterations = float(i) + 1.0 - log2(0.5 * log2(dot(z, z)));
        float t = sqrt(smoothIterations) * 0.35 + params.time * 0.03;
        color = 0.5 + 0.5 * cos(6.2831853 * (t + vec3(0.0, 0.15, 0.3)));
    }
    imageStore(target, p, vec4(color, 1.0));
}
