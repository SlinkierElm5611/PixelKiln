#version 450

layout(local_size_x = 8, local_size_y = 8) in;

// Binding 0 is left EMPTY by the program to show holes in the binding list.
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D target;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    imageStore(target, p, vec4(float(p.x) / 255.0, float(p.y) / 255.0, 0.0, 1.0));
}
