#version 450

// destination[i] = source[i] * 2 + 1, storage buffers only (no uniform data, so no transfer work between calls).
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) readonly buffer Source {
    uint values[];
} source;
layout(set = 0, binding = 1) writeonly buffer Destination {
    uint values[];
} destination;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    destination.values[i] = source.values[i] * 2u + 1u;
}
