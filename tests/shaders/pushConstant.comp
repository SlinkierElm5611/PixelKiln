#version 450

// output[index] = value, both read from a push constant block instead of a uniform buffer binding (compare store.comp).
layout(local_size_x = 1) in;

layout(push_constant) uniform PushConstants {
    uint index;
    uint value;
} pc;
layout(set = 0, binding = 0) buffer Output {
    uint values[];
} outputData;

void main()
{
    outputData.values[pc.index] = pc.value;
}
